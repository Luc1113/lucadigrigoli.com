    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <style is:global>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        :root{
            --cream:#faf6ef;
            --paper:#fffdf8;
            --ink:#2b241d;
            --ink-soft:#6b6153;
            --rule:#e6dcc9;
            --rust:#a8532e;
            --rust-deep:#7f3d20;
        }

        body{
            font-family:'Inter',sans-serif;
            background-color:var(--cream);
            color:var(--ink);
            line-height:1.6;
            -webkit-font-smoothing:antialiased;
            background-image:
                radial-gradient(ellipse 80% 50% at 12% 10%, rgba(255,170,190,.22), transparent 60%),
                radial-gradient(ellipse 70% 50% at 88% 22%, rgba(140,190,255,.2), transparent 60%),
                radial-gradient(ellipse 70% 50% at 25% 85%, rgba(160,255,215,.16), transparent 60%),
                radial-gradient(ellipse 70% 50% at 85% 92%, rgba(255,210,140,.2), transparent 60%);
            background-repeat:no-repeat;
            background-attachment:fixed;
            padding:0 20px 60px;
        }
        a{ color:var(--rust); }

        .container{ max-width:640px; margin:0 auto; padding-top:36px; }

        .back-link{
            display:inline-block; margin-bottom:26px; font-size:.85rem;
            color:var(--ink-soft); text-decoration:none;
        }
        .back-link:hover{ color:var(--rust); }

        .hero{ text-align:center; margin-bottom:36px; }
        .hero img{
            width:220px; height:220px; object-fit:cover; border-radius:8px;
            box-shadow:0 14px 34px rgba(43,36,29,.18);
            display:block; margin:0 auto 20px;
        }
        .hero h1{
            font-family:'Fraunces',serif; font-weight:600; color:var(--ink);
            margin:0 0 4px; font-size:2rem; letter-spacing:-.01em;
        }
        .hero .subtitle{ margin:0 0 10px; font-size:.95rem; color:var(--ink-soft); }
        .out-now{
            display:inline-block; font-size:.72rem; letter-spacing:.1em; text-transform:uppercase;
            color:var(--rust); font-weight:600; margin-bottom:18px;
        }

        .buttons{ display:flex; flex-wrap:wrap; gap:8px; justify-content:center; margin-bottom:10px; }
        .btn{
            display:inline-flex; align-items:center; gap:6px;
            padding:8px 16px; border-radius:100px;
            border:1px solid var(--rule); background:var(--paper);
            color:var(--ink); text-decoration:none; font-size:.85rem;
            transition:border-color .15s, transform .15s;
        }
        .btn:hover{ border-color:var(--rust); transform:translateY(-1px); }
        .btn.primary{ background:var(--rust); color:#fff; border-color:var(--rust); }
        .btn.primary:hover{ background:var(--rust-deep); border-color:var(--rust-deep); }

        h2{
            font-family:'Fraunces',serif; font-weight:600; color:var(--ink);
            font-size:1.3rem; border-bottom:1px solid var(--rule); padding-bottom:8px;
            margin-top:36px; margin-bottom:6px;
        }

        ol.tracklist{ padding-left:22px; margin:0 0 30px; }
        ol.tracklist li{ padding:7px 0; border-bottom:1px dashed var(--rule); }
        ol.tracklist li:last-child{ border-bottom:none; }
        .bonus{ color:var(--ink-soft); font-size:.8rem; }

        .footer-note{ text-align:center; font-size:.8rem; color:var(--ink-soft); margin-top:30px; }
    </style>
</head>
<body>

<div class="container">
    <a href="/" class="back-link">&larr; back home</a>

    <div class="hero">
        <img src="blogimg/521Deluxe.png" alt="521 (5th Anniversary Deluxe Edition) cover art" width="220" height="220">
        <h1>521</h1>
        <p class="subtitle">(5th Anniversary Deluxe Edition) — Luca DiGrigoli</p>
        <span class="out-now">out now</span>

        <div class="buttons">
            <a href="https://distrokid.com/hyperfollow/lucadigrigoli/521" class="btn primary" target="_blank" rel="noopener">stream everywhere</a>
            <a href="https://lucadigrigoli.bandcamp.com/merch" class="btn" target="_blank" rel="noopener">merch</a>
        </div>
    </div>

    <h2>tracklist</h2>
    <ol class="tracklist">
        <li>Without You</li>
        <li>Comes Back Around</li>
        <li>Felt The Same</li>
        <li>Who You Are</li>
        <li>Apologize</li>
        <li>I Love You!</li>
        <li>Lose Your Mind</li>
        <li>I'll Be There</li>
        <li>The One Who Got Away</li>
        <li>I Can't Be The One</li>
        <li>Valerie</li>
        <li>Back In The Day</li>
        <li>Rose Flavored Tea</li>
        <li>I'm Not Funny</li>
        <li>Walls</li>
        <li>Nemesis</li>
        <li>Who You Are (2020) <span class="bonus">(bonus)</span></li>
        <li>Lose Your Mind (2020) <span class="bonus">(bonus)</span></li>
        <li>Walls (2021) <span class="bonus">(bonus)</span></li>
        <li>Without You (2019) <span class="bonus">(bonus)</span></li>
    </ol>

    <p class="footer-note">521 (5th Anniversary Deluxe Edition) — Luca DiGrigoli — out now</p>
</div>

</body>
</html>
