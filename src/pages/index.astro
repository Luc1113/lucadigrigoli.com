const ldJson = `{"@context":"https://schema.org","@graph":[{"@type":"Person","@id":"https://lucadigrigoli.com/#person","name":"Luca DiGrigoli","url":"https://lucadigrigoli.com/","image":"https://lucadigrigoli.com/images/headshot-suit.webp","jobTitle":["Artist","Developer","Creator"],"sameAs":["https://open.spotify.com/artist/2Ty5D7qGvHpZ7TJoG6AUS2","https://github.com/Luc1113","https://www.linkedin.com/in/lucadigrigoli/","https://www.instagram.com/luca.digrigoli/"]},{"@type":"WebSite","@id":"https://lucadigrigoli.com/#website","url":"https://lucadigrigoli.com/","name":"Luca DiGrigoli","description":"Official website of Luca DiGrigoli, an artist, musician, developer, and creator sharing music releases, projects, blog updates, and computer science work.","publisher":{"@id":"https://lucadigrigoli.com/#person"}},{"@type":"WebPage","@id":"https://lucadigrigoli.com/#webpage","url":"https://lucadigrigoli.com/","name":"Luca DiGrigoli - Artist, Developer, Creator","description":"Official website of Luca DiGrigoli, an artist, musician, developer, and creator sharing music releases, projects, blog updates, and computer science work.","isPartOf":{"@id":"https://lucadigrigoli.com/#website"},"about":{"@id":"https://lucadigrigoli.com/#person"}}]}`;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
  <link rel="icon" type="image/png" href="/favicon.png">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Official website of Luca DiGrigoli, an artist, musician, developer, and creator sharing music releases, projects, blog updates, and computer science work.">
  <link rel="canonical" href="https://lucadigrigoli.com/">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Luca DiGrigoli - Artist, Developer, Creator">
  <meta property="og:description" content="Official website of Luca DiGrigoli, an artist, musician, developer, and creator sharing music releases, projects, blog updates, and computer science work.">
  <meta property="og:url" content="https://lucadigrigoli.com/">
  <meta property="og:image" content="https://lucadigrigoli.com/images/kissandtell-cover-preview.jpg">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Luca DiGrigoli - Artist, Developer, Creator">
  <meta name="twitter:description" content="Official website of Luca DiGrigoli, an artist, musician, developer, and creator sharing music releases, projects, blog updates, and computer science work.">
  <meta name="twitter:image" content="https://lucadigrigoli.com/images/kissandtell-cover-preview.jpg">
  <script type="application/ld+json" set:html={ldJson} />
    <title>Luca DiGrigoli - Artist, Developer, Creator</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="image" href="images/kissandtell-cover-preview.jpg" fetchpriority="high">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;500;600&family=Geist:wght@400;500;600&family=Inter+Tight:wght@500;700;800&family=Bebas+Neue&display=swap" rel="stylesheet">
    <style is:global>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        html { scroll-behavior: smooth; }

        :root{
            --cream:#f5f3e8;
            --paper:#fffdf8;
            --ink:#2b241d;
            --ink-soft:#6b6153;
            --rule:#e6dcc9;
            --rust:#8B4513;
            --rust-deep:#A0522D;
            --olive:#6b6b47;
            --teal:#2f7a72;
            --pink:#c05a7a;
            --mustard:#c68a1f;
            --blue:#3a6ea8;
        }

        body{
            font-family:'Times New Roman', 'Inter', serif;
            background-color:var(--cream);
            color:var(--ink);
            line-height:1.6;
            -webkit-font-smoothing:antialiased;
            background-image:
                radial-gradient(circle at 25% 25%, #f9f7f0 0%, transparent 50%),
                radial-gradient(circle at 75% 75%, #f0ede0 0%, transparent 50%);
            background-attachment:fixed;
        }


        a{ color:inherit; }

        .wrap{ max-width:920px; margin:0 auto; padding:0 24px; }

        /* ── SIDE RAILS (break at the code-fold / lamp section) ── */
        .rail-grid{
            display:grid;
            grid-template-columns:minmax(0,1fr) 920px minmax(0,1fr);
            column-gap:0;
            width:100%;
        }
        .rail{
            display:flex; flex-direction:column; gap:0;
            height:100%;
            padding-top:28px;
        }
        .rail-left{ align-items:flex-start; padding-left:14px; }
        .rail-right{ align-items:flex-end; padding-right:14px; }
        .rail-image{
            width:100%; max-width:250px;
            overflow:hidden; cursor:pointer;
            opacity:.88;
            transition:opacity .2s ease, filter .2s ease;
        }
        .rail-image:hover{ opacity:1; filter:brightness(1.06); }
        .rail-image picture{ display:block; width:100%; height:100%; }
        .rail-image img{ width:100%; height:auto; display:block; filter:sepia(10%) contrast(1.05) saturate(.95); }
        /* let the last photo in the upper rails stretch down to meet the lamp section */
        .rail-grid-upper .rail-image:last-child{ flex:1 1 auto; min-height:140px; }
        .rail-grid-upper .rail-image:last-child picture{ height:100%; }
        .rail-grid-upper .rail-image:last-child img{ height:100%; object-fit:cover; }
        @media(max-width:1300px){
            .rail-grid{ display:block; }
            .rail{ display:none; }
        }

        /* ── NEWS BANNER ── */
        .news-banner{
            background:var(--rust);
            color:#fff;
            padding:10px 0;
            overflow:hidden;
        }
        .news-scroll{
            display:flex; white-space:nowrap;
            animation:scroll-left 24s linear infinite;
            font-family:'Courier Prime',monospace;
            font-size:.85rem;
            will-change:transform;
        }
        .news-item{ padding-right:70px; display:inline-block; }
        .news-item::before{ content:"★ "; margin-right:5px; color:var(--cream); }
        @keyframes scroll-left{ 0%{transform:translateX(100vw)} 100%{transform:translateX(-100%)} }

        /* ── NAV ── */
        .nav{
            position:sticky; top:0; z-index:50;
            background:rgba(250,246,239,.88);
            backdrop-filter:blur(8px);
            border-bottom:1px solid var(--rule);
        }
        .nav-inner{
            display:flex; align-items:center; justify-content:space-between;
            padding:16px 24px; max-width:920px; margin:0 auto;
        }
        .nav-name{
            font-family:'Times New Roman',serif; font-weight:700; font-size:1.2rem;
            letter-spacing:-.01em; text-decoration:none;
            text-shadow:1px 1px 0 var(--rule);
        }
        .nav-links{ display:flex; gap:26px; list-style:none; }
        .nav-links a{
            font-family:'Courier Prime',monospace;
            font-size:.85rem; text-decoration:none; color:var(--ink-soft);
            text-transform:lowercase;
            transition:color .15s;
        }
        .nav-links a:hover{ color:var(--rust); }
        @media(max-width:560px){ .nav-links{ gap:16px; } }

        /* ── HERO ── */
        .hero{
            padding:76px 0 56px;
            display:grid;
            grid-template-columns:auto 1fr;
            gap:36px;
            align-items:center;
        }
        .hero-photo{
            width:132px; height:132px; border-radius:50%;
            overflow:hidden; flex-shrink:0;
            box-shadow:0 8px 24px rgba(43,36,29,.14);
            border:3px solid var(--paper);
            transform:rotate(-4deg);
            transition:transform .3s ease;
        }
        .hero-photo:hover{ transform:rotate(2deg) scale(1.03); }
        .hero-photo img{ width:100%; height:100%; object-fit:cover; display:block; }
        .eyebrow{
            font-family:'Courier Prime',monospace;
            font-size:.78rem; letter-spacing:.14em; text-transform:uppercase;
            color:var(--rust); font-weight:700; margin-bottom:8px;
            display:inline-block;
        }
        .typing-sub{
            font-size:.9rem; color:var(--ink-soft); font-family:'Courier Prime',monospace;
            overflow:hidden; white-space:nowrap; display:inline-block;
            border-right:2px solid var(--rust);
            animation:typing 2.2s steps(28,end) 1, blink-caret .8s step-end infinite;
            max-width:fit-content; margin-bottom:14px;
        }
        @keyframes typing{ from{width:0} to{width:100%} }
        @keyframes blink-caret{ from,to{border-color:transparent} 50%{border-color:var(--rust)} }
        .hero h1{
            font-family:'Times New Roman',serif; font-weight:800;
            font-size:clamp(2.6rem,6.5vw,4.2rem);
            letter-spacing:-.02em; line-height:1.05; margin-bottom:4px;
            color:var(--rust);
            text-shadow:2px 2px 0 var(--rule);
        }
        .hero p{ color:var(--ink-soft); font-size:1.02rem; max-width:52ch; }

        .animated-bar{
            height:3px; width:150px; margin:18px 0;
            background:linear-gradient(90deg,var(--rust) 0%,#CD853F 25%,#DEB887 50%,#CD853F 75%,var(--rust) 100%);
            animation:shimmer 3s ease-in-out infinite;
            will-change:transform;
        }
        @keyframes shimmer{ 0%,100%{transform:scaleX(1)} 50%{transform:scaleX(1.12)} }

        .hero-links{ display:flex; gap:10px; margin-top:20px; flex-wrap:wrap; }
        .pill{
            display:inline-flex; align-items:center; gap:6px;
            font-size:.84rem; text-decoration:none; padding:8px 16px;
            border:1px solid var(--rule); border-radius:100px;
            color:var(--ink); transition:border-color .15s, background .15s, transform .15s;
            background:var(--paper);
        }
        .pill:hover{ border-color:var(--rust); transform:translateY(-1px); }
        .pill.primary{ background:var(--rust); color:#fff; border-color:var(--rust); }
        .pill.primary:hover{ background:var(--rust-deep); border-color:var(--rust-deep); }

        .box-btn{
            display:inline-block;
            font-family:'Courier Prime',monospace;
            font-size:.9rem;
            color:var(--rust);
            text-decoration:none;
            border:1.5px solid var(--rust);
            padding:10px 22px;
            border-radius:2px;
            transition:background .2s, color .2s, transform .2s;
        }
        .box-btn:hover{ background:var(--rust); color:var(--cream); transform:translateY(-2px); }
        @media(max-width:600px){
            .hero{ grid-template-columns:1fr; text-align:center; padding-top:52px; }
            .hero-photo{ margin:0 auto; }
            .hero-links{ justify-content:center; }
            .hero p{ margin:0 auto; }
        }

        /* ── SECTION HEADINGS ── */
        section{ padding:52px 0; border-top:1px solid var(--rule); }
        section:first-of-type{ border-top:none; }

        /* ── PANEL (boxed section card, old-site feel) ── */
        .panel{
            background:rgba(255,255,255,.62);
            border:1px solid var(--rule);
            border-radius:16px;
            padding:32px;
            position:relative;
            overflow:hidden;
            box-shadow:0 0 0 1px rgba(139,69,19,.06), 0 10px 28px rgba(139,69,19,.1);
        }
        .panel::before{
            content:''; position:absolute; top:0; left:0; right:0; height:2px;
            background:linear-gradient(90deg,transparent 0%,var(--rust) 50%,transparent 100%);
        }

        /* ── VINTAGE DIVIDER ── */
        .vintage-divider{ text-align:center; margin:44px 0; position:relative; }
        .vintage-divider::before{
            content:''; position:absolute; top:50%; left:0; right:0; height:1px;
            background:linear-gradient(90deg,transparent,var(--rule),transparent);
        }
        .vintage-divider span{
            background:var(--cream); padding:0 18px; position:relative;
            font-family:'Courier Prime',monospace; font-size:.85rem; color:var(--rust);
        }
        .section-head{
            display:flex; align-items:baseline; justify-content:space-between;
            margin-bottom:28px; gap:16px; flex-wrap:wrap;
        }
        .section-head h2{
            font-family:'Times New Roman',serif; font-weight:700;
            font-size:1.5rem; letter-spacing:-.01em;
        }
        .section-head .more{ font-family:'Courier Prime',monospace; font-size:.82rem; color:var(--ink-soft); text-decoration:none; white-space:nowrap; }
        .section-head .more:hover{ color:var(--rust); }

        .lede{
            font-family:'Times New Roman',serif; font-weight:700; color:var(--rust);
            font-size:clamp(1.5rem,3.4vw,2rem); margin:0 0 8px;
        }

        /* ── FEATURED RELEASE ── */
        .feature{
            display:grid; grid-template-columns:220px 1fr; gap:32px;
            background:var(--paper); border:1px solid var(--rule);
            border-radius:14px; padding:28px; align-items:center;
            margin-bottom:18px;
        }
        .feature-cover{
            width:100%; aspect-ratio:1; border-radius:8px; overflow:hidden;
            box-shadow:0 14px 34px rgba(43,36,29,.16);
            transition:transform .25s ease;
        }
        .feature:hover .feature-cover{ transform:scale(1.02); }
        .feature-cover img{ width:100%; height:100%; object-fit:cover; display:block; }
        .feature-tag{
            display:inline-block; font-family:'Courier Prime',monospace; font-size:.72rem; letter-spacing:.1em; text-transform:uppercase;
            color:var(--rust); font-weight:700; margin-bottom:10px;
        }
        .feature h3{
            font-family:'Fraunces',serif; font-weight:600;
            font-size:clamp(1.6rem,3.4vw,2.15rem); line-height:1.08; margin-bottom:10px;
        }
        .feature p{ color:var(--ink-soft); font-size:.95rem; margin-bottom:16px; max-width:46ch; }

        /* ── RETRO BUTTON ── */
        .retro-button{
            background:linear-gradient(135deg,var(--rust),var(--rust-deep));
            color:#fff; border:none; padding:11px 22px; border-radius:8px;
            font-family:'Courier Prime',monospace; cursor:pointer;
            transition:transform .2s, box-shadow .2s;
            text-transform:uppercase; letter-spacing:1px; font-size:.88rem;
            box-shadow:0 4px 10px rgba(139,69,19,.28);
        }
        .retro-button:hover{ transform:translateY(-2px); box-shadow:0 6px 14px rgba(139,69,19,.38); }

        .stream-row{ display:flex; flex-wrap:wrap; gap:8px; }
        .stream-link{
            display:inline-flex; align-items:center; gap:6px;
            padding:7px 14px; border-radius:100px; font-size:.78rem; font-weight:600;
            text-decoration:none; transition:transform .15s, filter .15s;
        }
        .stream-link svg{ width:12px; height:12px; }
        .stream-link:hover{ transform:translateY(-1px); filter:brightness(1.08); }
        .stream-link.spotify{ background:#1DB954; color:#06210e; }
        .stream-link.apple{ background:linear-gradient(135deg,#fc3c44,#fa233b); color:#fff; }
        .stream-link.youtube{ background:#FF0000; color:#fff; }
        .stream-link.bandcamp{ background:#1da0c3; color:#fff; }
        .stream-link.ghost{ background:transparent; border:1px solid var(--rule); color:var(--ink); }
        @media(max-width:640px){
            .feature{ grid-template-columns:1fr; text-align:center; }
            .feature-cover{ max-width:200px; margin:0 auto; }
            .feature p{ margin:0 auto 16px; }
            .stream-row{ justify-content:center; }
        }

        /* ── RELEASE GRID ── */
        .grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
        @media(max-width:760px){ .grid{ grid-template-columns:repeat(2,1fr); } }
        @media(max-width:480px){ .grid{ grid-template-columns:1fr; } }

        .card{
            position:relative;
            background:var(--ink) center/cover no-repeat;
            border:1px solid var(--rule); border-radius:12px;
            padding:20px; transition:transform .2s ease, box-shadow .2s ease, border-color .2s ease;
            transform:rotate(var(--tilt,0deg));
            overflow:hidden;
            isolation:isolate;
        }
        .card::before{
            content:''; position:absolute; inset:0; z-index:0;
            background:linear-gradient(190deg, rgba(20,16,12,.32) 0%, rgba(20,16,12,.72) 60%, rgba(20,16,12,.88) 100%);
        }
        .card > *{ position:relative; z-index:1; }
        .card:nth-child(1){ --tilt:-.6deg; }
        .card:nth-child(2){ --tilt:.5deg; }
        .card:nth-child(3){ --tilt:-.4deg; }
        .card:nth-child(4){ --tilt:.6deg; }
        .card:nth-child(5){ --tilt:-.5deg; }
        .card:nth-child(6){ --tilt:.4deg; }
        .card:hover{ transform:rotate(0deg) translateY(-4px); box-shadow:0 14px 30px rgba(43,36,29,.22); border-color:#d8c9a8; }
        .card h4{ font-family:'Fraunces',serif; font-size:1.08rem; font-weight:600; margin-bottom:4px; color:#fff; }
        .card .sub{ font-family:'Courier Prime',monospace; font-size:.76rem; color:rgba(255,255,255,.6); margin-bottom:10px; }
        .card p.desc{ font-size:.87rem; color:rgba(255,255,255,.82); margin-bottom:14px; line-height:1.5; }
        .card .stream-row{ gap:6px; }
        .card .stream-link{ padding:5px 11px; font-size:.7rem; }
        .card .stream-link.ghost{ border-color:rgba(255,255,255,.35); color:#fff; }
        .card .stream-link.ghost:hover{ background:rgba(255,255,255,.12); }

        /* ── WORK / CS ── */
        /* full-bleed: break the fold out of .wrap so the themed backdrops span the whole viewport width */
        .code-fold{
            position:relative;
            width:100vw;
            margin-left:calc(50% - 50vw);
            background:#0f0b08;
            padding:30px 20px 26px;
            overflow:hidden;
            isolation:isolate;
        }
        .code-fold-inner{
            position:relative; z-index:2;
            max-width:920px; margin:0 auto;
        }
        .code-fold{
            --fg:#fff5e8; --fg-soft:rgba(255,240,225,.78); --accent:#e8b479; --item-bg:rgba(20,15,10,.55); --item-bd:rgba(255,220,180,.16); --chip:rgba(255,220,180,.14);
        }
        .code-fold[data-theme="0"]{ --fg:#fff; --fg-soft:rgba(255,255,255,.88); --accent:#f0f0f0; --item-bg:rgba(0,0,0,.18); --item-bd:rgba(255,255,255,.3); --chip:rgba(255,255,255,.16); }
        .code-fold[data-theme="1"]{ --fg:#2b2731; --fg-soft:#514b5c; --accent:#326dcc; --item-bg:rgba(255,255,255,.62); --item-bd:rgba(43,39,49,.28); --chip:rgba(50,109,204,.12); }
        .code-fold[data-theme="2"]{ --fg:#f4f4f5; --fg-soft:#a1a1aa; --accent:#e0482d; --item-bg:rgba(255,255,255,.04); --item-bd:rgba(255,255,255,.12); --chip:rgba(224,72,45,.16); }
        .code-fold[data-theme="3"]{ --fg:#ecebe3; --fg-soft:rgba(236,235,227,.78); --accent:#ecebe3; --item-bg:rgba(0,0,0,.16); --item-bd:rgba(236,235,227,.28); --chip:rgba(236,235,227,.14); }
        .code-fold[data-theme="4"]{ --fg:#ffffff; --fg-soft:#aab0c4; --accent:#5fc46a; --item-bg:rgba(255,255,255,.05); --item-bd:rgba(255,255,255,.12); --chip:rgba(95,196,106,.16); }
        .code-fold .section-head h2, .code-fold .section-head .more, .projects-heading, .work-item, .work-item h4, .work-item .sub, .work-item p, .tag, .car-btn, .car-tab{
            transition:color .7s ease, background-color .7s ease, border-color .7s ease;
        }
        .code-fold .section-head h2{ color:var(--fg); }
        .code-fold .section-head .more{ color:var(--fg-soft); }
        .code-fold .section-head .more:hover{ color:var(--accent); }
        .section-head-links{ display:flex; align-items:baseline; gap:18px; }
        .car-pause{
            padding:0; border:0; background:none; cursor:pointer; font-family:'Courier Prime',monospace; font-size:.82rem; white-space:nowrap;
            color:var(--fg-soft); transition:color .7s ease;
        }
        .car-pause:hover{ color:var(--accent); }
        .car-pause:focus-visible{ outline:2px solid var(--accent); outline-offset:3px; }
        .fold-themes{ position:absolute; inset:0; z-index:0; isolation:isolate; pointer-events:none; }
        .fold-theme{ position:absolute; inset:0; clip-path:circle(0% at var(--ox,50%) var(--oy,100%)); }
        .fold-theme.is-on{ clip-path:circle(150% at var(--ox,50%) var(--oy,100%)); }
        .fold-theme.is-reveal{ transition:clip-path 1s cubic-bezier(.65,0,.2,1); }
        .ft-bing{ background:radial-gradient(70% 60% at 100% 0%, rgba(255,255,255,.08), transparent 60%), linear-gradient(160deg,#0b2a22 0%,#04140f 100%); }
        .ft-doodle{ background-color:#f6f0dc; background-image:linear-gradient(rgba(61,105,180,.13) 1px,transparent 1px),linear-gradient(90deg,rgba(61,105,180,.13) 1px,transparent 1px); background-size:28px 28px; }
        .ft-wax{ background:radial-gradient(70% 55% at 85% 0%, rgba(224,72,45,.32), transparent 65%), radial-gradient(50% 50% at 10% 100%, rgba(244,244,245,.06), transparent 70%), #060607; }
        .ft-lwd{ background:linear-gradient(160deg,#565c47 0%,#454a38 100%); }
        .ft-today{ background:radial-gradient(60% 50% at 20% 0%, rgba(10,132,255,.25), transparent 65%), linear-gradient(170deg,#0b1020,#05070f); }

        .work-item{
            background:var(--item-bg); border:1px solid var(--item-bd); border-radius:12px;
            padding:22px 24px; margin-bottom:14px;
            backdrop-filter:blur(2px);
        }
        .work-item h4{ font-family:'Times New Roman',serif; font-size:1.15rem; font-weight:700; margin-bottom:3px; color:var(--fg); }
        .work-item .sub{ font-family:'Courier Prime',monospace; font-size:.8rem; color:var(--accent); margin-bottom:8px; font-weight:400; }
        .work-item p{ font-size:.92rem; color:var(--fg-soft); }
        .work-item a.link{ text-decoration:underline; color:#ffd8a0; font-size:.87rem; }
        .tag-row{ margin-top:12px; display:flex; gap:6px; flex-wrap:wrap; }
        .tag{
            font-family:'Courier Prime',monospace;
            font-size:.72rem; padding:3px 10px; border-radius:100px;
            background:var(--chip); color:var(--fg);
        }

        /* B.S. slide: the whole card is Binghamton green with a cream band and collegiate serif. */
        .proj-bing{
            border-radius:4px; background:#005a43; color:#fff; border:1px solid rgba(255,255,255,.2);
            box-shadow:0 18px 40px rgba(0,0,0,.3); display:flex; flex-direction:column;
        }
        .proj-bing-band{
            display:flex; justify-content:space-between; flex-wrap:wrap; gap:4px 12px; padding:12px 32px; background:#f3f1e8; color:#005a43;
            font-family:'Courier Prime',monospace; font-size:.74rem; font-weight:700; letter-spacing:.16em; text-transform:uppercase;
