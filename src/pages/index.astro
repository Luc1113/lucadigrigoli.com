        }
        .car-tab::before{ content:''; position:absolute; top:0; left:0; right:0; height:3px; border-radius:2px; background:var(--item-bd); }
        .car-tab::after{ content:''; position:absolute; top:0; left:0; height:3px; width:0; border-radius:2px; background:var(--accent); }
        .car-tab[aria-selected="true"]{ color:var(--fg); }
        .car-tab[aria-selected="true"]::after{ animation:car-fill 6s linear forwards; }
        .carousel.is-held .car-tab[aria-selected="true"]::after{ animation-play-state:paused; }
        @keyframes car-fill{ from{ width:0; } to{ width:100%; } }
