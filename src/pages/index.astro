<div style="text-align:center; padding:0 24px 50px;">
    <button class="retro-button" onclick="showMessage()">thanks for stopping by!</button>
</div>

<script is:inline>
(function(){
    'use strict';

    window.showMessage = function(){
        const msgs = ["you're the best kind of person", "seriously, thank you", "ok now go listen to Beautiful Girl", "secret handshake unlocked 🤝", "come back soon!"];
        let toast = document.getElementById('toast');
        if (!toast){
            toast = document.createElement('div');
            toast.id = 'toast';
            toast.style.cssText = 'position:fixed;left:50%;bottom:28px;transform:translateX(-50%) translateY(20px);background:#2b241d;color:#faf6ef;padding:10px 20px;border-radius:100px;font-family:Inter,sans-serif;font-size:.88rem;font-weight:600;opacity:0;transition:opacity .25s ease, transform .25s ease;z-index:100;pointer-events:none;';
            document.body.appendChild(toast);
        }
        toast.textContent = msgs[Math.floor(Math.random() * msgs.length)];
        requestAnimationFrame(function(){
            toast.style.opacity = '1';
            toast.style.transform = 'translateX(-50%) translateY(0)';
        });
        clearTimeout(window._toastTimer);
        window._toastTimer = setTimeout(function(){
            toast.style.opacity = '0';
            toast.style.transform = 'translateX(-50%) translateY(20px)';
        }, 2200);
    };

    const observer = new IntersectionObserver(function(entries){
        entries.forEach(function(entry){
            if (entry.isIntersecting){
                entry.target.style.opacity = '1';
                entry.target.style.transform = 'translateY(0)';
                observer.unobserve(entry.target);
            }
        });
    }, {threshold:.08, rootMargin:'40px'});

    document.querySelectorAll('.card, .work-item, .feature').forEach(function(el){
        el.style.opacity = '0';
        el.style.transform = 'translateY(14px)';
        el.style.transition = 'opacity .4s ease, transform .4s ease';
        observer.observe(el);
    });
})();

    (function(){
        const fold = document.querySelector('.code-fold');
        if (!fold) return;
        const slides = Array.from(fold.querySelectorAll('.slide'));
        const layers = Array.from(fold.querySelectorAll('.fold-theme'));
        const tabsEl = fold.querySelector('.car-tabs');
        const tabs = slides.map(function(sl, i){
            const t = document.createElement('button');
            t.type = 'button'; t.className = 'car-tab'; t.setAttribute('role', 'tab');
            t.textContent = sl.dataset.name;
            t.addEventListener('click', function(e){ go(i, e); });
            tabsEl.appendChild(t);
            return t;
        });
        let cur = -1, z = 1, busy = false;
        function origin(e){
            const r = fold.getBoundingClientRect();
            let x = r.width / 2, y = r.height;
            if (e && e.currentTarget && e.clientX !== undefined){
                const b = e.currentTarget.getBoundingClientRect();
                x = b.left + b.width / 2 - r.left; y = b.top + b.height / 2 - r.top;
            }
            return [x + 'px', y + 'px'];
        }
        function go(i, e, dir){
            i = (i + slides.length) % slides.length;
            if (i === cur || busy) return;
            const first = cur < 0;
            if (dir === undefined) dir = first ? 1 : (i > cur ? 1 : -1);
            const prev = first ? null : slides[cur], prevLayer = first ? null : layers[cur];
            fold.style.setProperty('--dir', dir);
            slides.forEach(function(sl){ sl.style.setProperty('--dir', dir); });
            if (prev){ prev.classList.remove('is-active'); prev.classList.add('is-leaving'); setTimeout(function(){ prev.classList.remove('is-leaving'); }, 950); }
            slides[i].classList.add('is-active');
            const layer = layers[i], o = origin(e);
            layer.style.setProperty('--ox', o[0]); layer.style.setProperty('--oy', o[1]);
            layer.style.zIndex = ++z;
            if (first){ layer.classList.add('is-on'); }
            else {
                busy = true;
                void layer.offsetWidth;
                layer.classList.add('is-reveal', 'is-on');
                setTimeout(function(){
                    prevLayer.classList.remove('is-on');
                    layer.classList.remove('is-reveal');
                    busy = false;
                }, 1000);
            }
            fold.setAttribute('data-theme', i);
            tabs.forEach(function(t, k){ t.setAttribute('aria-selected', k === i ? 'true' : 'false'); });
            cur = i;
        }
        fold.querySelectorAll('.car-btn').forEach(function(b){
            b.addEventListener('click', function(e){ const d = +b.dataset.dir; go(cur + d, e, d); });
        });
        const car = fold.querySelector('.carousel');
        car.addEventListener('keydown', function(e){
            if (e.key === 'ArrowRight') go(cur + 1, null, 1);
            if (e.key === 'ArrowLeft') go(cur - 1, null, -1);
        });
        let sx = null;
        car.addEventListener('touchstart', function(e){ sx = e.touches[0].clientX; }, {passive:true});
        car.addEventListener('touchend', function(e){
            if (sx === null) return;
            const dx = e.changedTouches[0].clientX - sx; sx = null;
            if (Math.abs(dx) > 50) go(cur + (dx < 0 ? 1 : -1), null, dx < 0 ? 1 : -1);
        });
        go(0);
        // The active tab's bar fills over 6s; when the fill finishes, advance to the next card.
        let heldByUser = false, offscreen = false;
        const pauseBtn = fold.querySelector('.car-pause');
        function sync(){ car.classList.toggle('is-held', heldByUser || offscreen || document.hidden); }
        tabs.forEach(function(t){
            t.addEventListener('animationend', function(){ if (t.getAttribute('aria-selected') === 'true') go(cur + 1, null, 1); });
        });
        pauseBtn.addEventListener('click', function(){
            heldByUser = !heldByUser;
            pauseBtn.setAttribute('aria-pressed', heldByUser);
            pauseBtn.setAttribute('aria-label', heldByUser ? 'Resume project slideshow' : 'Pause project slideshow');
            pauseBtn.innerHTML = heldByUser ? '&#9654; play' : '&#10074;&#10074; pause';
            sync();
        });
        document.addEventListener('visibilitychange', sync);
        if ('IntersectionObserver' in window){
            new IntersectionObserver(function(en){ offscreen = !en[0].isIntersecting; sync(); }, {threshold:.3}).observe(fold);
        }
        sync();
    })();

    (function(){
        const track = document.querySelector('.proj-wax-track');
        if (!track) return;
        const imgs = Array.from(track.children);
        for (let i = imgs.length - 1; i > 0; i--){ const j = Math.floor(Math.random() * (i + 1)); track.insertBefore(imgs[j], imgs[i]); }
        Array.from(track.children).forEach(function(n){ const c = n.cloneNode(); c.loading = 'eager'; track.appendChild(c); });
    })();
    (function(){
        const card = document.getElementById('lwd-card'), cv = document.getElementById('lwd-dust');
        if (!card || !cv || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const d = cv.getContext('2d');
        let w = 0, h = 0, ps = [], vis = false, raf = 0;
        const mouse = {x:-9999, y:-9999};
        const mk = function(y){ return {x:Math.random()*w, y:y === undefined ? Math.random()*h : y, size:1+Math.random()*2.2, speed:.08+Math.random()*.22, sway:.2+Math.random()*.5, phase:Math.random()*Math.PI*2, square:Math.random()<.35, px:0, py:0}; };
        new ResizeObserver(function(){
            const r = Math.min(window.devicePixelRatio || 1, 2);
            w = cv.clientWidth; h = cv.clientHeight;
            cv.width = w * r; cv.height = h * r; d.setTransform(r,0,0,r,0,0);
            ps = Array.from({length:Math.round(w * h / 9000)}, function(){ return mk(); });
        }).observe(cv);
        card.addEventListener('pointermove', function(e){ const b = cv.getBoundingClientRect(); mouse.x = e.clientX - b.left; mouse.y = e.clientY - b.top; });
        card.addEventListener('pointerleave', function(){ mouse.x = mouse.y = -9999; });
        function frame(t){
            if (!vis){ raf = 0; return; }
            d.clearRect(0,0,w,h);
            d.fillStyle = '#4f5441';
            for (const p of ps){
                p.y -= p.speed;
                const dx = p.x - mouse.x, dy = p.y - mouse.y, c = Math.hypot(dx, dy);
                if (c < 110 && c > 0){ const f = (1 - c / 110) * .6; p.px += dx / c * f; p.py += dy / c * f; }
                p.px *= .94; p.py *= .94; p.x += p.px; p.y += p.py;
                if (p.y < -10 || p.x < -20 || p.x > w + 20) Object.assign(p, mk(h + 10));
                const x = p.x + Math.sin(t / 1800 + p.phase) * p.sway * 6;
                d.globalAlpha = .3 + .3 * Math.sin(t / 900 + p.phase * 3);
                if (p.square) d.fillRect(x, p.y, p.size * 1.4, p.size * 1.4);
                else { d.beginPath(); d.arc(x, p.y, p.size, 0, Math.PI * 2); d.fill(); }
            }
            raf = requestAnimationFrame(frame);
        }
        new IntersectionObserver(function(en){ vis = en[0].isIntersecting; if (vis && !raf) raf = requestAnimationFrame(frame); }).observe(cv);
    })();
</script>
