        .car-tabs{ flex:1; display:flex; gap:8px; }
        .car-tab{
            flex:1; min-width:0; padding:10px 4px 0; border:0; background:none; cursor:pointer; text-align:left;
            font-family:'Courier Prime',monospace; font-size:.78rem; color:var(--fg-soft);
