<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
  <link rel="icon" type="image/png" href="/favicon.png">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QR code generator</title>
    <style is:global>
        body {
            font-family: Verdana, Geneva, sans-serif;
            max-width: 400px;
            margin: 60px auto;
            padding: 0 15px;
            color: #222;
        }
        h1 { font-size: 1.2rem; margin-bottom: 16px; }
        label { display: block; font-size: 0.85rem; margin: 4px 0; }
        select { width: 100%; padding: 8px; font-size: 1rem; margin-bottom: 10px; }
        input:not([type=file]) {
            width: 100%;
            padding: 8px;
            font-size: 1rem;
            box-sizing: border-box;
            margin-bottom: 10px;
        }
        button {
            padding: 8px 16px;
            font-size: 1rem;
            cursor: pointer;
        }
        .colors { display: flex; flex-wrap: wrap; gap: 12px 20px; margin-bottom: 12px; }
        .colors label { display: flex; align-items: center; gap: 8px; }
        input[type=color] { width: 40px; height: 30px; padding: 0; border: 1px solid #ccc; cursor: pointer; }
        #result { margin-top: 20px; }
        #result img { display: block; border: 1px solid #ccc; }
        a.download { display: inline-block; margin-top: 10px; }
    </style>
</head>
<body>
    <h1>QR code generator</h1>
    <form id="qrForm">
        <input type="text" id="urlInput" placeholder="enter a url" required>
        <label for="logoSelect">logo in the middle</label>
        <select id="logoSelect">
            <option value="none">none</option>
            <option value="youtube">YouTube</option>
            <option value="spotify">Spotify</option>
            <option value="custom">custom image…</option>
        </select>
        <input type="file" id="logoFile" accept="image/*" hidden>
        <div id="customRow" hidden>
            <button type="button" id="browseBtn">browse…</button>
            <span id="fileName">no file chosen</span>
        </div>
        <div class="colors">
            <label>foreground <input type="color" id="fgColor" value="#000000"></label>
            <label>background <input type="color" id="bgColor" value="#ffffff"></label>
            <label><input type="checkbox" id="outlineOn"> outline <input type="color" id="outlineColor" value="#ff0000"></label>
        </div>
        <button type="submit">generate</button>
    </form>
    <div id="result"></div>

    <script is:inline src="/utmtool/qrcode.min.js"></script>
    <script is:inline>
        var form = document.getElementById('qrForm');
        var input = document.getElementById('urlInput');
        var select = document.getElementById('logoSelect');
        var file = document.getElementById('logoFile');
        var result = document.getElementById('result');
        var fgInput = document.getElementById('fgColor');
        var bgInput = document.getElementById('bgColor');
        var outlineOn = document.getElementById('outlineOn');
        var outlineInput = document.getElementById('outlineColor');

        var LOGOS = {
            youtube: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect x="4" y="20" width="92" height="60" rx="18" fill="#FF0000"/><path d="M41 36v28l24-14z" fill="#fff"/></svg>',
            spotify: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><circle cx="50" cy="50" r="48" fill="#1DB954"/><g fill="none" stroke="#000" stroke-linecap="round"><path d="M22 36c19-6 42-4 58 6" stroke-width="8"/><path d="M25 51c16-5 35-3 49 5" stroke-width="7"/><path d="M28 65c13-4 28-2 40 4" stroke-width="6"/></g></svg>'
        };

        var customRow = document.getElementById('customRow');
        var browseBtn = document.getElementById('browseBtn');
        var fileName = document.getElementById('fileName');

        select.addEventListener('change', function () {
            var isCustom = select.value === 'custom';
            customRow.hidden = !isCustom;
            if (isCustom && !file.files[0]) file.click();
        });
        browseBtn.addEventListener('click', function () { file.click(); });
        file.addEventListener('change', function () {
            fileName.textContent = file.files[0] ? file.files[0].name : 'no file chosen';
        });

        function loadImage(src) {
            return new Promise(function (resolve, reject) {
                var img = new Image();
                img.onload = function () { resolve(img); };
                img.onerror = reject;
                img.src = src;
            });
        }

        function getLogo() {
            var v = select.value;
            if (v === 'none') return Promise.resolve(null);
            if (v === 'custom') {
                if (!file.files[0]) return Promise.resolve(null);
                return loadImage(URL.createObjectURL(file.files[0]));
            }
            return loadImage('data:image/svg+xml;charset=utf-8,' + encodeURIComponent(LOGOS[v]));
        }

        form.addEventListener('submit', function (e) {
            e.preventDefault();
            var value = input.value.trim();
            if (!value) return;
            getLogo().catch(function () { return null; }).then(function (logo) {
                // error correction H survives ~30% damage, so a small centre logo is safe
                var qr = qrcode(0, 'H');
                qr.addData(value);
                qr.make();
                var n = qr.getModuleCount(), quiet = 4, cell = Math.ceil(900 / (n + quiet * 2));
                var size = (n + quiet * 2) * cell;
                var canvas = document.createElement('canvas');
                canvas.width = canvas.height = size;
                var ctx = canvas.getContext('2d');
                ctx.fillStyle = bgInput.value;
                ctx.fillRect(0, 0, size, size);
                if (outlineOn.checked) {
                    // paint each dark module slightly enlarged first; the real modules go on top
                    var o = Math.max(1, Math.round(cell * 0.25));
                    ctx.fillStyle = outlineInput.value;
                    for (var r0 = 0; r0 < n; r0++)
                        for (var c0 = 0; c0 < n; c0++)
                            if (qr.isDark(r0, c0)) ctx.fillRect((c0 + quiet) * cell - o, (r0 + quiet) * cell - o, cell + o * 2, cell + o * 2);
                }
                ctx.fillStyle = fgInput.value;
                for (var r = 0; r < n; r++)
                    for (var c = 0; c < n; c++)
                        if (qr.isDark(r, c)) ctx.fillRect((c + quiet) * cell, (r + quiet) * cell, cell, cell);

                if (logo) {
                    var box = Math.round(size * 0.22), pad = Math.round(box * 0.12);
                    var x = (size - box) / 2, y = x;
                    ctx.fillStyle = bgInput.value;
                    ctx.beginPath();
                    ctx.roundRect(x - pad, y - pad, box + pad * 2, box + pad * 2, pad * 1.5);
                    ctx.fill();
                    var s = Math.min(box / logo.width, box / logo.height);
                    var w = logo.width * s, h = logo.height * s;
                    ctx.drawImage(logo, (size - w) / 2, (size - h) / 2, w, h);
                }

                var url = canvas.toDataURL('image/png');
                result.innerHTML = '<img src="' + url + '" width="300" height="300" alt="QR code">' +
                    '<br><a class="download" href="' + url + '" download="qr.png">download</a>';
            });
        });
    </script>
</body>
</html>
