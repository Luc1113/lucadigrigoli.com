<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QR code generator</title>
    <style is:global>
        body {
            font-family: Verdana, Geneva, sans-serif;
            max-width: 400px;
            margin: 60px auto;
            padding: 0 15px;
            color: #222;
        }
        h1 { font-size: 1.2rem; margin-bottom: 16px; }
        input {
            width: 100%;
            padding: 8px;
            font-size: 1rem;
            box-sizing: border-box;
            margin-bottom: 10px;
        }
        button {
            padding: 8px 16px;
            font-size: 1rem;
            cursor: pointer;
        }
        #result { margin-top: 20px; }
        #result img { display: block; border: 1px solid #ccc; }
        a.download { display: inline-block; margin-top: 10px; }
    </style>
</head>
<body>
    <h1>QR code generator</h1>
    <form id="qrForm">
        <input type="text" id="urlInput" placeholder="enter a url" required>
        <button type="submit">generate</button>
    </form>
    <div id="result"></div>

    <script is:inline>
        var form = document.getElementById('qrForm');
        var input = document.getElementById('urlInput');
        var result = document.getElementById('result');

        form.addEventListener('submit', function (e) {
            e.preventDefault();
            var value = input.value.trim();
            if (!value) return;
            var src = 'https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=' + encodeURIComponent(value);
            result.innerHTML = '<img src="' + src + '" width="300" height="300" alt="QR code for ' + value + '">' +
                '<br><a class="download" href="' + src + '" download="qr.png">download</a>';
        });
    </script>
</body>
</html>
